elif {GameState.interaction_npc} == "petrus":
	join Petrus (Neutral) left
	Petrus: You'll want the spring, not here. This one needs boiling and people forget.
	- Then why are you here?
		Hope: Then why are you here?
		Petrus: Queue's shorter.
	set {GameState.met_petrus} = true
	[signal arg="increment:roster_met_count:1"]
	[signal arg="increment:roster_met_count:1"]
